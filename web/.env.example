# Leave empty in local dev — vite.config.js proxies /api to serverless-offline
# on http://localhost:3000. Set this to the deployed API Gateway URL for prod.
VITE_API_BASE=

# OAuth client id from the Google Cloud console, "Web application" type. Must be
# the same value the backend verifies against (GOOGLE_CLIENT_ID in
# backend/serverless.yml) — the ID token is minted for this client and rejected
# for any other. The site's origin also has to be listed under that client's
# Authorized JavaScript origins, or Identity Services refuses to render.
# Leaving it unset drops the Google button and its divider; email/password
# sign-in is unaffected.
VITE_GOOGLE_CLIENT_ID=
